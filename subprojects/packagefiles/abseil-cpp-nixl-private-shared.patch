+# NIXL: one private, namespaced shared library (nixl_absl) instead of 14 static ones. Abseil's libraries
+# reference each other cyclically (strings <-> synchronization), which a split shared build cannot link, and a
+# static copy per consumer breaks absl::Mutex's deadlock detector (several copies in one process).
+absl_nixl_lib = shared_library(
+  'nixl_absl',
+  link_whole: [absl_base_static, absl_hash_static, absl_numeric_static, absl_profiling_static, absl_crc_static, absl_strings_static, absl_debugging_static, absl_random_static, absl_time_static, absl_synchronization_static, absl_container_static, absl_flags_static, absl_status_static, absl_log_static],
+  dependencies: [dependency('threads'), libatomic],
+  link_args: ['-Wl,--version-script=' + meson.current_source_dir() / 'nixl_absl.map'],
+  link_depends: files('nixl_absl.map'),
+  install: true,
+  install_rpath: '$ORIGIN',
+  version: '2508.0.0',
+  soversion: '2508',
+)
+
+absl_base_lib = absl_nixl_lib
+absl_hash_lib = absl_nixl_lib
+absl_numeric_lib = absl_nixl_lib
+absl_profiling_lib = absl_nixl_lib
+absl_crc_lib = absl_nixl_lib
+absl_strings_lib = absl_nixl_lib
+absl_debugging_lib = absl_nixl_lib
+absl_random_lib = absl_nixl_lib
+absl_time_lib = absl_nixl_lib
+absl_synchronization_lib = absl_nixl_lib
+absl_container_lib = absl_nixl_lib
+absl_flags_lib = absl_nixl_lib
+absl_status_lib = absl_nixl_lib
+absl_log_lib = absl_nixl_lib
+
 # Dependencies
 absl_base_dep = declare_dependency(
   include_directories: absl_include_dir,
diff -ruN a/nixl_absl.map b/nixl_absl.map
--- a/nixl_absl.map	1970-01-01 00:00:00.000000000 +0000
+++ b/nixl_absl.map	2026-11-26 12:42:57.719217804 +0000
@@ -0,0 +1,9 @@
+/* Keep the few symbols that are NOT inside Abseil's inline namespace out of the dynamic symbol table: ABSL_FLAG
+   variables (FLAGS_*) and their helpers live in the global namespace, so another Abseil in the same process
+   (same or other version) would interpose with them and abort with "Inconsistency between flag object and
+   registration". Everything else is in absl::nixl_lts_20250814. */
+{
+  local:
+    *FLAGS_*;
+    *AbslFlagDefaultGenFor*;
+};
